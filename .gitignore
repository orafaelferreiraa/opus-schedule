# Artefatos gerados a nível de projeto (os subdiretórios src/ e infra/terraform/
# têm .gitignore próprios; este cobre a raiz).
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
.venv-ci/

# Scratch de trabalho (downloads/transcrições temporárias) — nunca versionar.
.scratch/

# Harness de curadoria local (tools/curate/): dados brutos/derivados por execução.
# Os veredictos (verdicts.json) e o relatório (report.md) PODEM ser versionados como
# entregável; clips.json e transcripts.md são volumosos e regeneráveis pelo prep.py.
review/**/clips.json
review/**/transcripts.md

# Configuração local do Claude Code (não versionar).
.claude/settings.local.json

# Segredo: config local do Functions com a OpusClip API key (já ignorado em
# src/.gitignore; redundância de segurança para nunca commitar por engano).
src/local.settings.json
local.settings.json
tiktok.local.settings.json
